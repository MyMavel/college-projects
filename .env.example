# บนเซิร์ฟเวอร์: ไม่ต้องสร้างเอง ให้รัน  bash deploy/setup-server.sh  แล้วระบบจะสร้างให้
# บนเครื่องตัวเอง (npm run dev): คัดลอกเป็น .env แล้วแก้ค่า

# พอร์ต (ต้องไม่ซ้ำกับแอปอื่นบนเซิร์ฟเวอร์เดียวกัน)
APP_PORT=3001        # พอร์ตภายในของแอป (Nginx ส่งต่อมาที่นี่)
PUBLIC_PORT=8081     # พอร์ตที่ผู้ใช้เปิดในเบราว์เซอร์ → http://IP:8081
DB_PORT=5433         # พอร์ตฐานข้อมูลสำหรับ DBeaver (เฉพาะในเครื่องเซิร์ฟเวอร์)

POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# ผู้ดูแลระบบคนแรก (ใช้ตอนเปิดแอปครั้งแรกเท่านั้น หลังจากนั้นเปลี่ยนรหัสในหน้า "บัญชีของฉัน")
ADMIN_USERNAME=admin
ADMIN_PASSWORD='change-me-please'

COOKIE_SECURE=false

# สำหรับ npm run dev บนเครื่องตัวเองเท่านั้น
DATABASE_URL=postgres://app:change-me@localhost:5433/app
